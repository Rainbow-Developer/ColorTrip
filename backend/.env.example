# 핵심 인프라
APP_ENV=local
LOG_LEVEL=
DATABASE_URL=postgresql+asyncpg://colortrip:colortrip@localhost:5432/colortrip

# 인증 / Kakao
JWT_SECRET_KEY=local-dev-secret-key-at-least-32-bytes-long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
KAKAO_APP_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_REST_API_KEY=
KAKAO_TOKEN_INFO_URL=https://kapi.kakao.com/v1/user/access_token_info
KAKAO_TOKEN_URL=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URL=https://kapi.kakao.com/v2/user/me

# 외부 API (한국관광공사 TourAPI) — 키는 Secret Manager로 관리, 로컬은 .env
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 사진 AI 인증 (Gemini) — 비우면 스텁 판정으로 동작 (docs/specs/050-quest-verification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# QR 인증 서명 키 — 비우면 JWT_SECRET_KEY에서 파생
QR_SECRET_KEY=

# GPS 인증 화면의 지도 배경 (VWorld 이미지 API) — 비우면 배경 없이 도식만 그린다.
# 발급: https://www.vworld.kr/dev/v4api.do → 오픈API 신청 → 활용 API "이미지 API"
VWORLD_API_KEY=

# 지자체 오픈 API 서비스키 해시 키 — 비우면 JWT_SECRET_KEY에서 파생
OPEN_API_KEY_SECRET=

# 업로드 (인증 사진) — 버킷 설정 시 GCS(운영), 미설정 시 로컬 디스크(개발·테스트)
GCS_UPLOAD_BUCKET=
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# 공유 링크의 공개 origin. Android 에뮬레이터에서 로컬 API를 쓸 때는 http://10.0.2.2:8000
SHARE_BASE_URL=http://localhost:8000

# 공개 법적 문서 — 실제 운영·계약 사실만 입력한다. dev/prod에서는 모두 필수이며,
# 값이 비어 있으면 API가 기동하지 않는다. 개인정보처리방침 본문과 동의 다이제스트에 사용된다.
# 개인정보처리자 이름 — 개인이면 실명, 사업자면 상호를 입력한다.
LEGAL_OPERATOR_NAME=
# 이용약관 문서 버전 — 본문 또는 법적 사실을 바꾸면 새 버전으로 올린다(예: terms-v3).
LEGAL_TERMS_VERSION=terms-v2
# 개인정보처리방침 문서 버전 — 본문 또는 법적 사실을 바꾸면 새 버전으로 올린다(예: privacy-v3).
LEGAL_PRIVACY_VERSION=privacy-v2
# 두 문서의 실제 시행일(YYYY-MM-DD) — 버전을 올릴 때 함께 변경한다.
LEGAL_DOCUMENT_EFFECTIVE_DATE=2026-08-15
# 이용자와 개인정보 문의를 받는 운영자 이메일 주소.
LEGAL_OPERATOR_EMAIL=
# 개인정보처리자의 실제 우편 주소.
LEGAL_OPERATOR_ADDRESS=
# 개인정보 보호책임자 또는 담당자의 성명.
LEGAL_PRIVACY_OFFICER_NAME=
# 개인정보 열람·정정·삭제·처리정지 요청을 받는 담당자 이메일 주소.
LEGAL_PRIVACY_OFFICER_EMAIL=
# 사진 저장을 맡는 실제 수탁자 법인명(예: Google LLC).
LEGAL_GCS_PROCESSOR_NAME=
# 사진 저장이 이루어지는 실제 국가명(예: 대한민국).
LEGAL_GCS_PROCESSING_COUNTRY=
# GCS 버킷의 실제 리전(예: asia-northeast3). 콘솔 설정과 반드시 일치해야 한다.
LEGAL_GCS_REGION=
# 사진 AI 판정을 맡는 실제 수탁자 법인명(예: Google LLC).
LEGAL_GEMINI_PROCESSOR_NAME=
# Gemini 사진 처리가 이루어지는 실제 국가명. Google 계약·서비스 문서로 확인해 입력한다.
LEGAL_GEMINI_PROCESSING_COUNTRY=
# Gemini가 사진을 처리·보유하는 실제 기간 또는 계약상 보유 기준.
LEGAL_GEMINI_RETENTION_PERIOD=
# 공개 공유 링크와 공유 카드 데이터의 실제 보유·삭제 기준.
LEGAL_SHARE_RETENTION_PERIOD=
# 회원 탈퇴 뒤 남기는 비식별 집계 통계의 실제 보유 기간 또는 기준.
LEGAL_AGGREGATE_RETENTION_PERIOD=
