# deploy/docker-compose.yml 가 읽는 환경변수 템플릿.
# 실제 .env는 인스턴스에서 생성하며 커밋하지 않는다(루트 .gitignore가 .env 무시).
# DB 비밀번호 등 시크릿은 Secret Manager에서 가져와 채운다(아래 README 참고).

# 이미지 (CI가 빌드·푸시한 태그로 교체)
API_IMAGE=asia-northeast3-docker.pkg.dev/colortrip/colortrip-dev/api:latest

# Cloud SQL Auth Proxy 연결 이름 (terraform output cloud_sql_connection_name)
CLOUD_SQL_CONNECTION_NAME=colortrip:asia-northeast3:colortrip-dev-db

# Caddy가 Let's Encrypt 인증서를 발급받을 호스트명.
# 도메인 미구매 상태라 sslip.io 와일드카드 DNS를 쓴다(IP를 이름으로 해석해주는 공개 DNS).
# 정식 도메인이 생기면 이 값만 교체한다. 근거: docs/specs/065-dev-https/plan.md
API_DOMAIN=34-64-226-70.sslip.io

# --- BE 앱 환경변수 ---
# DB는 cloudsql-proxy 컨테이너(:5432)로 접속. PASSWORD는 Secret Manager(colortrip-dev-db-password)에서 주입.
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://colortrip:PASSWORD@cloudsql-proxy:5432/colortrip
JWT_SECRET_KEY=SECRET_MANAGER_VALUE
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
KAKAO_REST_API_KEY=SECRET_MANAGER_VALUE
KAKAO_REDIRECT_URI=SECRET_MANAGER_VALUE
KAKAO_APP_ID=
KAKAO_TOKEN_INFO_URL=https://kapi.kakao.com/v1/user/access_token_info
KAKAO_CLIENT_SECRET=SECRET_MANAGER_VALUE
TOUR_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# 콤마 구분 도메인 화이트리스트. local/test 외에는 "*" 불가(빈 값은 허용 도메인 없음으로 통과)
CORS_ALLOWED_ORIGINS=

# --- 공개 법적 문서 ---
# 실제 운영자·계약·처리 사실만 입력한다. dev/prod 환경에서 하나라도 비어 있으면 API가
# 시작되지 않는다. 값은 /terms·/privacy 본문과 동의 증빙 다이제스트에 반영된다.
# 개인정보처리자 이름 — 개인이면 실명, 사업자면 상호를 입력한다.
LEGAL_OPERATOR_NAME=
# 이용약관 문서 버전 — 본문 또는 법적 사실을 바꾸면 새 버전으로 올린다(예: terms-v3).
LEGAL_TERMS_VERSION=terms-v2
# 개인정보처리방침 문서 버전 — 본문 또는 법적 사실을 바꾸면 새 버전으로 올린다(예: privacy-v3).
LEGAL_PRIVACY_VERSION=privacy-v2
# 두 문서의 실제 시행일(YYYY-MM-DD) — 버전을 올릴 때 함께 변경한다.
LEGAL_DOCUMENT_EFFECTIVE_DATE=2026-08-15
# 이용자와 개인정보 문의를 받는 운영자 이메일 주소.
LEGAL_OPERATOR_EMAIL=
# 개인정보처리자의 실제 우편 주소.
LEGAL_OPERATOR_ADDRESS=
# 개인정보 보호책임자 또는 담당자의 성명.
LEGAL_PRIVACY_OFFICER_NAME=
# 개인정보 열람·정정·삭제·처리정지 요청을 받는 담당자 이메일 주소.
LEGAL_PRIVACY_OFFICER_EMAIL=
# 사진 저장을 맡는 실제 수탁자 법인명. LEGAL_GCS_*는 기존 키 이름이며,
# GCS가 아닌 Compute Engine 영속 볼륨을 쓰는 경우에도 실제 저장 수탁자를 입력한다.
LEGAL_GCS_PROCESSOR_NAME=
# 사진 저장이 이루어지는 실제 국가명(예: 대한민국).
LEGAL_GCS_PROCESSING_COUNTRY=
# 실제 사진 저장소의 리전과 방식(예: asia-northeast3 (Compute Engine Docker 영속 볼륨)).
LEGAL_GCS_REGION=
# 사진 AI 판정을 맡는 실제 수탁자 법인명(예: Google LLC).
LEGAL_GEMINI_PROCESSOR_NAME=
# Gemini 사진 처리가 이루어지는 실제 국가명. Google 계약·서비스 문서로 확인해 입력한다.
LEGAL_GEMINI_PROCESSING_COUNTRY=
# Gemini가 사진을 처리·보유하는 실제 기간 또는 계약상 보유 기준.
LEGAL_GEMINI_RETENTION_PERIOD=
# 공개 공유 링크와 공유 카드 데이터의 실제 보유·삭제 기준.
LEGAL_SHARE_RETENTION_PERIOD=
# 회원 탈퇴 뒤 남기는 비식별 집계 통계의 실제 보유 기간 또는 기준.
LEGAL_AGGREGATE_RETENTION_PERIOD=
