# ColorTrip dev — TLS 종단 리버스 프록시
# 인증서는 Let's Encrypt에서 자동 발급·갱신된다(ACME HTTP-01, 80포트 필요).
# {$API_DOMAIN} 은 deploy.sh 가 .env 로 주입한다. 도메인을 바꾸면 그 값만 바꾸면 된다.
# 설계 근거: docs/specs/065-dev-https/plan.md
{
	# 인증서 만료 알림 수신처. 잘못된 값이면 ACME 등록이 거부되므로 실제 주소를 쓴다.
	email rainbow.dev00@gmail.com
}

{$API_DOMAIN} {
	# api 컨테이너는 호스트 포트를 열지 않는다 — compose 내부망으로만 접근한다.
	reverse_proxy api:8000

	encode gzip

	log {
		output stdout
		format console
	}
}
